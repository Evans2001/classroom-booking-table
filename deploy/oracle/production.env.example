# Copy to /etc/room-booking.env on the server; chmod 600. This is a
# systemd EnvironmentFile, not a shell script or a Next.js .env file.
NODE_ENV=production
ADMIN_PUBLIC_ORIGIN=https://booking.161.118.220.77.sslip.io
ADMIN_EMAIL=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME
ADMIN_SESSION_SECRET=CHANGE_ME
ROOM_BOOKING_DB_PATH=/var/lib/room-booking/room-booking.sqlite
CAMPUS_TIME_ZONE=Asia/Colombo
NEXT_PUBLIC_CAMPUS_TIME_ZONE=Asia/Colombo
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=CHANGE_ME
# Optional Firebase push configuration. Use literal \n between private-key lines.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
